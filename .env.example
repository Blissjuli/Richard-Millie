# Copy to .env for local development:  cp .env.example .env
# .env is gitignored — never commit the real value.
#
# In production this is set in the Vercel dashboard:
#   Settings → Environment Variables → RSVP_ENDPOINT
#   (mark it Production; add Preview if you want previews to submit)

# Formspree form endpoint the RSVP form POSTs to.
# Note: a Formspree form ID is a public identifier, not a secret. This file
# exists to keep config out of git history and out of diffs — it is not a
# security control. Spam is handled by the honeypot field + Formspree's
# own filtering and domain restriction.
RSVP_ENDPOINT=https://formspree.io/f/XXXXXXX
